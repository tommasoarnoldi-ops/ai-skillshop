{
  "name": "forgeai-multiagent-system",
  "version": "1.0.0",
  "description": "ForgeAI Multi-Agent System - Autonomous AI agents that collaborate to build and scale the ForgeAI startup",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "repl": "tsx src/index.ts repl",
    "bootstrap": "tsx src/index.ts bootstrap -v",
    "sprint": "tsx src/index.ts sprint",
    "workflow": "tsx src/index.ts workflow",
    "serve": "tsx src/index.ts serve -v",
    "demo": "tsx src/index.ts demo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "eventemitter3": "^5.0.1",
    "express": "^5.2.1",
    "uuid": "^10.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
